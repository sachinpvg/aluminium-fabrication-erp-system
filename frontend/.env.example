# ── Backend API ──────────────────────────────────
# In local dev with CRA proxy, leave blank (empty string).
# The CRA "proxy" field in package.json forwards /api/* to localhost:8081.
#
# In production on Vercel, set to your deployed backend URL.
# If using Render for backend:  https://aluminium-erp-backend.onrender.com
# If using Vercel serverless:   https://your-project.vercel.app
REACT_APP_API_BASE_URL=

# ── WhatsApp ─────────────────────────────────────
# WhatsApp Business number with country code, no + or spaces (e.g. 919876543210)
REACT_APP_WHATSAPP_PHONE=
